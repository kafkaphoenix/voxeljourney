{
  "name": "voxeljourney",
  "version": "0.1.0",
  "description": "A voxel engine written in modern C++ and OpenGL, with a focus on learning and documentation.",
  "homepage": "https://github.com/kafkaphoenix/voxeljourney",
  "license": "MIT",
  "dependencies": [
    {
      "name": "glad",
      "features": [
        "gl-api-46"
      ]
    },
    "glfw3",
    "glm",
    "stb",
    "tinygltf",
    "tomlplusplus"
  ],
  "overrides": [
    {
      "name": "glad",
      "version": "0.1.36"
    },
    {
      "name": "glfw3",
      "version": "3.4#1"
    },
    {
      "name": "glm",
      "version": "1.0.1#3"
    },
    {
      "name": "stb",
      "version": "2024-07-29#1"
    },
    {
      "name": "tinygltf",
      "version": "2.9.7"
    },
    {
      "name": "tomlplusplus",
      "version": "3.4.0#1"
    }
  ]
}
